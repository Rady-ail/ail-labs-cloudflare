{
  "name": "ail-labs-katalog-v2",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-03",
  "keep_vars": true,
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGIN": "https://ail-aesthetic-labs.my.id",
    "GOOGLE_CALLBACK_URL": "https://ail-aesthetic-labs.my.id/api/customer/auth/google/callback",
    "PAYPAL_MODE": "live"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
