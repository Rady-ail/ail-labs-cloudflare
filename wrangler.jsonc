{
  "name": "ail-labs-katalog-v2",
  "main": "src/worker.js",
  "workers_dev": true,
  "routes": [
    { "pattern": "ail-aesthetic-labs.my.id", "custom_domain": true },
  ],
  "compatibility_date": "2026-10-03",
  "keep_vars": true,
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGIN": "https://ail-aesthetic-labs.my.id",
    "GOOGLE_CALLBACK_URL": "https://ail-aesthetic-labs.my.id/api/customer/auth/google/callback",
    "PAYPAL_MODE": "live",
    "VISITOR_PHOTO_PURGE_ENABLED": "false"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": { "enabled": true }
}
