{
  "name": "ail-labs-katalog-v2",
  "main": "src/worker.js",
  "workers_dev": true,
  "routes": [
    // Apex dan www sudah punya record DNS proxied (masih mengarah ke origin lama),
    // sehingga custom_domain ditolak (error 100117). Pakai route zona agar Worker
    // mengintersep permintaan tanpa menghapus/mengubah DNS.
    { "pattern": "ail-aesthetic-labs.my.id/*", "zone_name": "ail-aesthetic-labs.my.id" },
    { "pattern": "www.ail-aesthetic-labs.my.id/*", "zone_name": "ail-aesthetic-labs.my.id" },
    { "pattern": "katalog.ail-aesthetic-labs.my.id", "custom_domain": true },
  ],
  "compatibility_date": "2026-10-03",
  "keep_vars": true,
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGIN": "https://ail-aesthetic-labs.my.id",
    "ADMIN_EMAIL": "rady@ail-aesthetic-labs.my.id",
    "MAIL_FROM": "AIL LABS <info@ail-aesthetic-labs.my.id>",
    "GOOGLE_CALLBACK_URL": "https://ail-aesthetic-labs.my.id/api/customer/auth/google/callback",
    "PAYPAL_MODE": "live"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/catalog", "/catalog.html"]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": { "enabled": true }
}
