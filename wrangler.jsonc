{
  "name":"ail-labs-b2b-os",
  "main":"src/index.js",
  "compatibility_date":"2026-10-06",
  "assets":{"directory":"./public","binding":"ASSETS","run_worker_first":["/api/*"]},
  "d1_databases":[{"binding":"DB","database_name":"ail-labs-b2b","database_id":"REPLACE_IN_CLOUDFLARE_DASHBOARD"}],
  "kv_namespaces":[{"binding":"RATE_LIMIT","id":"REPLACE_IN_CLOUDFLARE_DASHBOARD"}],
  "vars":{"PUBLIC_BASE_URL":"https://ail-aesthetic-labs.my.id"},
  "triggers":{"crons":["0 * * * *"]},
  "observability":{"enabled":true}
}