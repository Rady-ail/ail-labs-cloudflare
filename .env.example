# Salin file ini jadi .env, lalu isi nilainya masing-masing (jangan commit .env ke git).

# Connection string PostgreSQL (Neon / Supabase / dll)
DATABASE_URL=postgres://user:password@host/dbname

# Login panel admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-yang-aman

# Teks acak bebas untuk enkripsi cookie session — makin panjang makin aman
SESSION_SECRET=ganti-dengan-teks-acak-panjang

# Opsional: hanya perlu diisi kalau frontend dan API di-hosting di domain
# BERBEDA (mis. domain custom terpisah dari alamat Render). Kalau frontend
# & API satu domain (kasus normal di paket ini), biarkan kosong.
# Bisa isi lebih dari satu domain, pisahkan dengan koma.
ALLOWED_ORIGIN=


# Email / receipt delivery
ADMIN_EMAIL=
MAIL_FROM=
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_USD_RATE=

# Google customer login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# WhatsApp Cloud API / webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Optional legacy/automation integrations
FONNTE_TOKEN=
ZAPIER_WEBHOOK_URL=

# Database query timeout in milliseconds
DB_QUERY_TIMEOUT_MS=8000

# RFQ persistence — keep false until db/migration-rfq-phase1.sql is applied to Neon
RFQ_PERSISTENCE_ENABLED=false
