{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ail-labs-workspace",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "app.ail-aesthetic-labs.my.id", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "EMAIL_SEND_MODE": "dry-run" }
}