{
  "name": "ail-labs-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:dry-run": "wrangler deploy --dry-run --config wrangler.jsonc",
    "dev:ui": "vite ui --config ui/vite.config.ts",
    "build:ui": "vite build ui --config ui/vite.config.ts",
    "typecheck:ui": "tsc --noEmit -p ui/tsconfig.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "hono": "^4.10.6",
    "motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.44.0"
  }
}
